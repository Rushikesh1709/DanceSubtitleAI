# Copy this file to ".env" to override defaults. All values are optional.
SECRET_KEY=change-this-to-any-random-text
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
MAX_UPLOAD_MB=500
MAX_VIDEO_SECONDS=1200
# Optional: full path to ffmpeg.exe if it is not on PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# Optional: use another database
# DATABASE_URL=sqlite:///data/dance_subtitles.db
